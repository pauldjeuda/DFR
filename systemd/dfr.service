[Unit]
Description=Distributed File Replicator Daemon
After=network.target

[Service]
Type=forking
ExecStart=/usr/bin/dfrd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target