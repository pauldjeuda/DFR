#!/usr/bin/make -f
%:
	dh $@ --with python3 --buildsystem=none

override_dh_auto_install:
	install -D -m 0755 scripts/dfrd debian/dfr/usr/sbin/dfrd
	install -D -m 0755 scripts/dfr-ctl debian/dfr/usr/bin/dfr-ctl
	install -D -m 0755 scripts/dfr-web debian/dfr/usr/bin/dfr-web
	install -D -m 0755 scripts/setup-ssh.sh debian/dfr/usr/sbin/dfr-setup-ssh
	install -D -m 0755 scripts/ssh-gate debian/dfr/usr/lib/dfr/ssh-gate
	install -d -m 0755 debian/dfr/usr/lib/python3/dist-packages/dfr
	cp -a dfr/*.py dfr/templates dfr/static debian/dfr/usr/lib/python3/dist-packages/dfr/
	install -D -m 0644 config/dfr.conf.example debian/dfr/etc/dfr/dfr.conf

override_dh_auto_test:
	:

override_dh_installsystemd:
	dh_installsystemd --no-start --no-enable
	dh_installsystemd --no-start --no-enable --name=dfr-web
